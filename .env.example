# Token gratuito de datos.gov.co (Socrata). Opcional; sube el límite de peticiones.
DATOS_GOV_APP_TOKEN=

# Directorio de aterrizaje (por defecto ./data)
DATOS_DIR=./data

# Postgres en Neon (ADR 0002). Copiar la cadena desde Neon → Connect, eligiendo el rol.
# Rol escritor_cron: `cargar`. En GitHub va como secret DATABASE_URL.
DATABASE_URL=
# Rol dueño (neondb_owner): solo `aplicar-sql`, solo en este .env local. Nunca en GitHub.
DATABASE_URL_OWNER=
# Rol lector: Claude Desktop, build de Evidence, consultas en VS Code.
DATABASE_URL_LECTOR=
